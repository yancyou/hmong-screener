container_image = docker://pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel
universe = container
executable = setup_cosine_cmp.sh
request_gpus = 1
request_cpus = 4
request_memory = 24GB
request_disk = 40GB
+GPUJobLength = "short"
gpus_minimum_capability = 8.0
gpus_minimum_memory = 20G
requirements = (OpSysMajorVer == 9) && (Target.HasCHTCStaging == true) && (Machine =!= "gpu4003.chtc.wisc.edu") && (Machine =!= "txie-dsigpu4000.chtc.wisc.edu")
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = setup_cosine_cmp.sh, cosine_embed.py, cmp_clips.csv
transfer_output_files = cosine_emb.npz
output = cosine_cmp_$(Cluster).out
error  = cosine_cmp_$(Cluster).err
log    = cosine_cmp_$(Cluster).log
notification = Never
queue 1
