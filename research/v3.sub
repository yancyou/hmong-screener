container_image = docker://pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel
universe = container
executable = setup_v3.sh
arguments = $(kind) $(model) $(fold)
request_gpus = 1
request_cpus = 8
request_memory = $(mem)
request_disk = $(disk)
+GPUJobLength = "$(glen)"
gpus_minimum_capability = 8.0
gpus_minimum_memory = $(gmem)
requirements = (OpSysMajorVer == 9) && (Target.HasCHTCStaging == true) && (Machine =!= "gpu4003.chtc.wisc.edu") && (Machine =!= "txie-dsigpu4000.chtc.wisc.edu")
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = setup_v3.sh, run_v3.sh, extract_losses.py, requirements.txt, fairseq.tar.gz, manifest_full33.tar.gz, full33_index.csv
transfer_output_files = joblogs_$(kind)_$(model)_$(fold).tar.gz
output = v3b_$(kind)_$(model)_$(fold)_$(Cluster).out
error  = v3b_$(kind)_$(model)_$(fold)_$(Cluster).err
log    = v3b_$(Cluster).log
notification = Error
priority = 47
queue kind,model,fold,gmem,glen,mem,disk from jobs_v3.txt
