container_image = docker://pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel
universe = container
executable = setup_train.sh
arguments = $(fold) rlz
request_gpus = 1
request_cpus = 8
request_memory = 48GB
request_disk = 60GB
+GPUJobLength = "long"
gpus_minimum_capability = 8.0
gpus_minimum_memory = 40000M
requirements = (OpSysMajorVer == 9) && (Target.HasCHTCStaging == true) && (Machine =!= "gpu4003.chtc.wisc.edu") && (Machine =!= "txie-dsigpu4000.chtc.wisc.edu")
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = setup_train.sh, run_train.sh, requirements.txt, fairseq.tar.gz, manifest_full32.tar.gz
transfer_output_files = full32_$(fold)_rlz_output.tar.gz
output = full32_$(fold)_$(Cluster).out
error  = full32_$(fold)_$(Cluster).err
log    = full32_$(fold)_$(Cluster).log
notification = Never
priority = 47
queue fold from fold_list.txt
